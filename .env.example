# Copiar/configurar solo en el entorno apropiado. No son credenciales.
# En Vercel Production se requiere un origen HTTPS real y explícito.
CONVETE_PUBLIC_ORIGIN=https://convete.vercel.app
# En Production/Preview de Vercel el modo demo es true por defecto.
# false se reserva para una entrega de clientes intencional y revisada.
CONVETE_PUBLIC_DEMO=true
# Preview ignora CONVETE_PUBLIC_ORIGIN: usa VERCEL_URL (hostname de Vercel),
# o CONVETE_PREVIEW_ORIGIN=https://HOST_PREVIEW_CONFIRMADO, nunca localhost.
# No se fija un hostname Preview inventado en este archivo.
